{
  "expo": {
    "name": "Open the Fridge",
    "slug": "openthefridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gratiacore.openthefridge",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Open the Fridge uses your photos so you can add pictures to your recipes.",
        "NSCameraUsageDescription": "Open the Fridge uses the camera so you can take pictures of your recipes."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gratiacore.openthefridge",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Open the Fridge",
      "shortName": "Fridge",
      "themeColor": "#F6F3FA",
      "backgroundColor": "#F6F3FA",
      "description": "Share recipes with your people. Your fridge door, online."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3FA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Open the Fridge uses your photos so you can add pictures to your recipes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Open the Fridge saves your photo slides to your camera roll so you can post them to TikTok.",
          "savePhotosPermission": "Open the Fridge saves your photo slides to your camera roll so you can post them to TikTok."
        }
      ]
    ],
    "scheme": "openthefridge",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ebe9aaa6-4791-4f46-a6d0-5b54d5d526d2"
      }
    }
  }
}
