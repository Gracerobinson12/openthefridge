# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API (or "Connect").
# Leave them empty to run the app in demo mode with sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Your web address (used for share links from the phone apps)
EXPO_PUBLIC_SITE_URL=https://recipes.gratiacore.com
